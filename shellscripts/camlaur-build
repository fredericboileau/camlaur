#!/usr/bin/env ysh

use $LIB_YSH/args.ysh --pick parser parseArgs
use $_this_dir/lib/ConfUtils.ysh
use $_this_dir/lib/Chroot.ysh

const progname = "camlaur"
const subprogname = "build"
const tmp_base = get(ENV, 'TMPDIR', '/tmp') ++ "/$progname-$UID"
const var_tmp_base = get(ENV, 'TMPDIR', '/var/tmp') ++ "/$progname-$UID"
# Need global for trap_exit later
var tmp, var_tmp

proc trap_exit {
  proc diag_moved_packages (dir) {
    echo >&2 'Note:'
    pr -to 4 >&2 <<< """
$progname-$subprogname encountered an error before moving packages to the local repository.
This may happen when signing built packages with gpg ($progname $subprogname --sign)
or with certain makepkg errors

The following files were preserved:"""

    printf '%q\n' @[glob("$dir/*")] | pr -to 8 >&2
  }

  if (not ('AUR_DEBUG' in first(ENV))) {
    if (tmp is not null) {
      rm -rf -- "$tmp"
    }
    if (var_tmp is not null) {
      if ! rm -df -- $var_tmp {
        diag_moved_packages $var_tmp
      }
    }
  } else {
    if (tmp is not null) {
      echo >&2 "AUR_DEBUG: $progname-$subprogname: temporary files at $tmp"
    }
    if (var_tmp is not null) {
      echo >&2 "AUR_DEBUG: $progname-$subprogname: temporary files at $var_tmp"
    }
  }
}

proc main {
  parser (&spec) {
    #flag -c --chroot (Bool, default=false)
    flag -C --pacman-conf (Str, default="")
    flag -M --makepkg-conf (Str, default="")
    flag -B --build-packages (List[Str], default=[])
  }
  var args = parseArgs(spec, ARGV)

  trap --add EXIT { trap_exit }

  try {
    mkdir -pm 0700 -- $tmp_base
    setglobal tmp = $(mktemp -d --tmpdir=$tmp_base "$subprogname.XXXXXXXX")
    mkdir -pm 0700 -- $var_tmp_base
    setglobal var_tmp = $(mktemp -d --tmpdir=$var_tmp_base "$subprogname.XXXXXXXX")
  }
  if failed {
    echo >&2 "$progname-$subprogname: could not create temp directories:"
    echo >&2 "  tmp_base=$tmp_base"
    echo >&2 "  var_tmp_base=$var_tmp_base"
    exit 2
  }

  var conf
  ConfUtils resolve_conf_files (args, &conf)
  var file_repos # dict sectionHeader -> filePath
  ConfUtils find_file_repos (conf, &file_repos)
  var bindmounts = values(file_repos) # turn the dict into a list

  var directory = Chroot.default_directory
  Chroot create (conf, directory, args['build-packages'])
  Chroot check_root (directory)
  Chroot update (conf, directory, bindmounts, args['build-packages'])

}

if is-main {
    main @ARGV
}
