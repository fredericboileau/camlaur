#!/usr/bin/env ysh

use $LIB_YSH/args.ysh --pick parser parseArgs
use $_this_dir/lib/ConfUtils.ysh
use $_this_dir/lib/Chroot.ysh
use $_this_dir/lib/Util.ysh --pick map barename

const startdir = $(pwd)
const progname = "camlaur"
const subprogname = "build"
const tmp_base = get(ENV, 'TMPDIR', '/tmp') ++ "/$progname-$UID"
const var_tmp_base = get(ENV, 'TMPDIR', '/var/tmp') ++ "/$progname-$UID"
# Need global for trap_exit later
var tmp, var_tmp

proc trap_exit {
  proc diag_moved_packages (dir) {
    echo >&2 'Note:'
    pr -to 4 >&2 <<< """
$progname-$subprogname encountered an error before moving packages to the local repository.
This may happen when signing built packages with gpg ($progname $subprogname --sign)
or with certain makepkg errors

The following files were preserved:"""
    printf '%q\n' @[glob("$dir/*")] | pr -to 8 >&2
  }
  if (not ('AUR_DEBUG' in first(ENV))) {
    if (tmp is not null) {
      rm -rf -- "$tmp"
    }
    if (var_tmp is not null) {
      if ! rm -df -- $var_tmp {
        diag_moved_packages $var_tmp
      }
    }
  } else {
    if (tmp is not null) {
      echo >&2 "AUR_DEBUG: $progname-$subprogname: temporary files at $tmp"
    }
    if (var_tmp is not null) {
      echo >&2 "AUR_DEBUG: $progname-$subprogname: temporary files at $var_tmp"
    }
  }
}

proc namcap_test (; q, noconfirm, skip_p) {
  echo "$q namcap output:"
  namcap --info PKGBUILD
  if (not noconfirm) {
    var answer
    write -n -- "$progname: proceed with build? [Y/n]"
    read --raw-line (&answer)
    if (answer === 'n') {
        call skip_p->setValue(true)
    }
  }
}

proc list_packages(; db_root, makepkg_conf, pkglist_out, exist_out) {
  var pkglist
  try {
    setvar pkglist = @(env PKGDEST=$db_root makepkg --config $makepkg_conf --packagelist)
  }
  if failed {
    echo >&2 "$progname: makepkg --packagelist failed"
    exit 2
  }
  if (len(pkglist) === 0) {
    echo >&2 "$progname: makepkg listed no packages for this PKGBUILD"
    exit 2
  }
  var exist = []
  for p in (pkglist) {
    if test -f $p {
      call exist->append(p)
    }
  }
  call pkglist_out->setValue(pkglist)
  call exist_out->setValue(exist)
}

proc find_gpg_key (; conf, out) {
  var gpg_key
  if ('GPGKEY' in first(ENV)) {
    setvar gpg_key = ENV.GPGKEY
  } else {
    var gpg_retrieve = '''
      source /usr/share/makepkg/util/config.sh
      load_makepkg_config "$1"
      printf "%s" "$GPGKEY"
    '''
    setvar gpg_key = $(bash -c $gpg_retrieve _ $[conf['makepkg.conf']])
  }
  if (gpg_key === '') {
    if ! gpg --batch --detach-sign --output /dev/null <<< 'test' {
      echo >&2 "$progname: --sign requested but no signing key available"
      exit 2
    }
    echo >&2 "$progname: no GPGKEY set in env or makepkg.conf, will use default signing key"
  } else {
    try {
      gpg >&2 --list-keys $gpg_key
    }
    if failed {
      echo >&2 "$progname: coudldnt find gpgkey: $gpg_key"
      exit 2
    }
  }
  call out->setValue(gpg_key)
}

proc main {
  parser (&spec) {
    flag -a --arg-file (Str, default='')
    flag -C --pacman-conf (Str, default='')
    flag -M --makepkg-conf (Str, default='')
    flag -B --build-packages (List[Str], default=[])
    flag -d --database (Str, default='')
    flag -x --dbext (Str, default='')
    flag -s --sign (Bool, default=false)
    flag -z --null (Bool, default=false)
    flag '' --namcap (Bool, default=false)
    flag -y --noconfirm (Bool, default=false)
    flag -f --force (Bool, default=false)
    flag '' --pool (Str, default='')
  }
  var args = parseArgs(spec, ARGV)

  if (args.namcap) {
    if ! command -v namcap >/dev/null {
        echo >&2 "$progname: asked for namcap but the binary cannot be found in path"
        exit 2
    }
  }

  trap --add EXIT { trap_exit }

  try {
    mkdir -pm 0700 -- $tmp_base
    setglobal tmp = $(mktemp -d --tmpdir=$tmp_base "$subprogname.XXXXXXXX")
    mkdir -pm 0700 -- $var_tmp_base
    setglobal var_tmp = $(mktemp -d --tmpdir=$var_tmp_base "$subprogname.XXXXXXXX")
  }
  if failed {
    echo >&2 "$progname-$subprogname: could not create temp directories:"
    echo >&2 "  tmp_base=$tmp_base"
    echo >&2 "  var_tmp_base=$var_tmp_base"
    exit 2
  }

  var conf
  ConfUtils resolve_conf_files (args, &conf, suffix=args.database)
  var file_repos # dict sectionHeader -> filePath
  ConfUtils find_file_repos (conf, &file_repos)

  if (len(file_repos) === 0) {
    echo >&2 "Error: No file repo configured in :" $[conf['pacman.conf']]
    exit 1
  }
  if (args.database === '' and len(file_repos) > 1) {
    echo >&2 "Error no database specified and more than one available: ambiguous"
    echo >&2 "Possible values are:" @[keys(file_repos)]
    exit 1
  }
  if (args.database !== '' and args.database not in file_repos) {
    echo >&2 "Error $[args.database] is not in file repos"
    echo >&2 "Looked in conf file $[conf['pacman.conf']]"
    echo >&2 "Possible values are:" @[keys(file_repos)]
    exit 1
  }

  # Now either args.database is in file_repos or there is only one file_repos configured
  var db_name = ConfUtils.first_non_empty(args.database, keys(file_repos)[0])
  var db_root = file_repos[db_name]
  var db_ext =  ConfUtils.first_non_empty(args.dbext, 'db')
  var db_path = "$db_root/$db_name.$db_ext"
  try {
    setvar db_root = $(realpath -e -- $db_root)
  }
  if failed {
    echo >&2 "$progname: Couldn't resolve $db_root"
    exit 2
  }
  try {
    setvar db_path = $(realpath -e -- $db_path)
  }
  if failed {
    echo >&2 "$progname: Couldn't resolve  $db_path"
    exit 2
  }
  if (db_path.endsWith('.db')) {
    echo >&2 "$progname: $db_path does not have a valid extension"
    echo >&2 "This usually happens on file systems that don't support symlinks (SMB/CIFS)"
    echo >&2 "You can pass the archive s real extension with --dbext, e.g. db.tar.zst"
    exit 2
  }
  if ! test -f $db_path {
    echo >&2 "$progname: db_path=$db_path is not a regular file"
    exit 2
  }
  if ! test -w $db_path {
    echo >&2 "$progname: db_path=$db_path: permission denied"
    exit 13
  }
  var db_pool = ''
  if (args.pool !== '') {
    try {
      setvar db_pool = $(realpath -e -- $[args.pool])
    }
    if failed {
      echo >&2 "$progname: Couldn't resolve path for $[args.pool]"
      exit 2
    }
    if ! test -w $db_pool {
      echo >&2 "$progname: db_pool=$db_pool permission denied"
      exit 13
    }
  }

  var gpg_key = ''
  if (not args.sign) {
    var db_sig = "$db_root/$db_name.db.sig"
    if test -f $db_sig {
      echo >&2 "$progname: $db_sig: database signature found, but signing is disabled"
      exit 1
    }
  } else {
    find_gpg_key (conf, &gpg_key)
  }

  # Always build in a chroot
  var bindmounts = values(file_repos) # turn the dict into a list
  var directory = Chroot.default_directory
  Chroot create (conf, directory, args['build-packages'])
  Chroot check_root (directory)
  Chroot update (conf, directory, bindmounts, args['build-packages'])

  # Make queue of pkgs (a list) to build either from --arg-file or
  # implicitly the PWD of this script
  var queue
  if (args['arg-file'] !== '') {
    var input
    try {
      read --all (&input) < $[args['arg-file']]
    }
    if failed {
      echo >&2 "$progname: Couldn't read from passed queue file: $[args['arg-file']]"
      exit 2
    }
    var eol = \y00 if args['null'] else \n
    setvar queue = input.lines(eol=eol)
  } else {
    setvar queue = [startdir]
  }

  var sign_p = ['-s'] if args.sign else []
  var gpg_args = ['-u', gpg_key] if gpg_key !== '' else []
  for q in (queue) {
    if (q === '') {
      echo >&2 "$progname: Empty directory passed in --arg-file"
      exit 2
    }
    cd $q {
      echo >&2 "$progname: building $q"
      if ! test -f PKGBUILD {
        echo >&2 "$progname: $q doesn't contain a PKGBUILD"
        exit 2
      }
      if (args.namcap) {
        var skip_p
        namcap_test (q, args.noconfirm, &skip_p)
        if (skip_p) {
          continue
        }
      }
      # Just to update versions in vcs (-git) packages
      makepkg >&2 -od --config $[conf['makepkg.conf']]

      var pkglist = []
      var exist = []
      if (not args.force) {
        list_packages (db_root, conf['makepkg.conf'], &pkglist, &exist)
      }
      # if --force these will be false because we never fill the lists
      var fresh = len(pkglist) > 0 and len(exist) === 0
      var partial = len(exist) > 0 and (len(exist) < len(pkglist))
      if (partial) {
        echo >&2 "$progname: warning: package group partially built, rebuilding"
        printf >&2 '%q\n' @exist
      }
      var create = args.force or partial or fresh

      if (create) {
        PKGDEST="$var_tmp" Chroot build (directory, bindmounts, makepkg_args=['--holdver'])
        cd $var_tmp {
          setvar pkglist = []
          for p in (glob('*')) {
            if (not p.endsWith('.sig')) {
              call pkglist->append(p)
            }
          }
          if (len(pkglist) === 0) {
            echo >&2 "$progname: build of $q produced no packages in $var_tmp"
            exit 2
          }
        }
      } else {
        echo >&2 "$progname: warning: skipping existing packages (use -f to overwrite)"
        printf >&2 '%q\n' @exist
      }
      cd $var_tmp {
        var siglist = []
        for p in (pkglist) {
          # already bare if create was true but otherwise need to strip
          var pbase = barename(p)
          # signature from makepkg --sign
          if test -f $pbase.sig {
            call siglist->append("$pbase.sig")
          # Skipped package build with signature
          } elif test -f $db_root/$pbase.sig && ! test -f $pbase {
            printf >&2 '%s: existing signature file %q\n' $progname $db_root/$pbase.sig
          } elif (args.sign) {
            ... gpg
                @gpg_args
                --detach-sign
                --no-armor
                --batch
                --output $pbase.sig
                $p
                ;
            printf >&2 '%s: created signature file %q\n' $progname $pbase.sig
            call siglist->append("$pbase.sig")
          }
        }
        if (create) {
          # pkglist/siglist contain basename
          if (db_pool !== '' and db_root !== db_pool) {
            mv -f @siglist @pkglist $db_pool
            var targets = []
            for t in (pkglist ++ siglist) {
              call targets->append("$db_pool/$t")
            }
            # absolute symlinks
            ln -t $db_root -sf -- @targets
          } else {
            mv -f @siglist @pkglist $db_root
          }
        } elif (len(siglist) > 0)  {
          mv -f @siglist $db_root
        }
        # allow repo-add even if nothing was built, for leftover packages
        ... env
            -C $db_root
            LANG=C
            repo-add
            @sign_p
            --wait-for-lock
            $db_path
            @pkglist
      }
    }
  }
}

if is-main {
  main @ARGV
}
# vim: ft=ysh
