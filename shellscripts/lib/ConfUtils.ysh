const progname = "camlaur"
const machine = $(uname -m)
const etcdir = "/etc/aurutils"
const shrdir = "/usr/share/devtools"
const default_pacman_paths = :| 
  $etcdir/pacman-$machine.conf 
  $shrdir/pacman.conf.d/aurutils-$machine.conf 
|
const default_makepkg_paths = :|
  $etcdir/makepkg-$machine.conf
  $shrdir/makepkg.conf.d/$machine.conf 
|

func first_non_empty(...values) {
  for v in (values) {
    if (v !== '' and v is not null) {
      return (v)
    }
  }
  return ('')
}

proc find_file_repos (;conf, out){
  var file_repos = {}
  var pacman_config = @(pacman-conf --config $[conf['pacman.conf']])

  var section_pat = / %start '[' <capture ![ ']' ]+ as section> ']' /
  var server_file_pat = / %start 'Server' s* '=' s* 'file://' <capture dot+ as path> /
  var current_section

  for line in (pacman_config) {
    if (line ~ section_pat) {
      setvar current_section = _group('section')
    } elif (line ~ server_file_pat) {
      setvar file_repos[current_section] = _group('path')
    }
  } 
  call out->setValue(file_repos)
}

proc resolve_conf_files (; args, out) {
  #If conf values passed are empty (""), try one from default_paths
  #If either the non empty or default_paths are not regular files, exit with message

  proc diag_conf_missing (; what, pathschecked) {
    var msg = """
$progname could not find file $what. Before using $progname, make sure this file
is created and valid. The following file paths were checked:
"""
    write -n -- $msg >&2
    printf '%q\n' @pathschecked >&2
  }

  var confs =  {
    "pacman.conf":  {cli: args['pacman-conf'], defaults: default_pacman_paths},
    "makepkg.conf": {cli: args['makepkg-conf'], defaults: default_makepkg_paths}
  } 

  var result = {}
  for name, spec in (confs) {
    if (spec.cli !== "") {
      if ! test -f $[spec.cli] {
        diag_conf_missing (name, [spec.cli])
        exit 2
      }
      setvar result[name] = spec.cli
    } else {
      for path in @[spec.defaults] {
        if test -f $path {
          setvar result[name] = path
          break
        }
      }
      if (get(result, name, null) is null) {
        diag_conf_missing (name, spec.defaults)
        exit 2
      } 
    }
    if ! test -r $[result[name]] {
      printf >&2 '%s: Could not read file: %q\n' $progname $[result[name]] 
      exit 2
    }
  }
  call out->setValue(result)
}


setvar __provide__ = :|
  resolve_conf_files 
  find_file_repos 
  first_non_empty 
|
