#!/usr/bin/env ysh
# camlaur-chroot: command-line front end for lib/Chroot.ysh

use $LIB_YSH/args.ysh --pick parser parseArgs
use $_this_dir/lib/ConfUtils.ysh
use $_this_dir/lib/Chroot.ysh

setglobal ENV.PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"



proc main {

  parser (&spec) {
    flag -C --pacman-conf (Str, default="")
    flag -M --makepkg-conf (Str, default="")
    flag -D --directory (Str, default=Chroot.default_directory)
    flag -c --create (Bool, default=false)
    flag -U --update (Bool, default=false)
    flag -B --build (Bool, default=false)
    rest base_packages
  }
  var args = parseArgs(spec, ARGV)
  var directory = args.directory

  var conf
  ConfUtils resolve_conf_files (args, &conf)
  var bindmounts = []
  ConfUtils find_file_repos (conf, &bindmounts)

  if (args.create) {
    Chroot create (conf, directory, args.base_packages)
  }
  Chroot check_root (directory)
  if (args.update) {
    Chroot update (conf, directory, bindmounts, args.base_packages)
  }
  if (args.build) {
    Chroot build (directory, bindmounts)
  }
}

if is-main {
  main @ARGV
}

# vim: ft=ysh
